    <string name="fp_switch_title">Game assistant</string>
    <string name="fp_switch_desc">Shows a small handle on the screen edge and runs your game profiles while a game is open.</string>
    <string name="fp_games_hint">In the \"Only in games\" setting the handle appears for games that have Floating panel switched on in their own settings (Library, open a game, Settings).</string>
    <string name="fp_need_overlay">Allow display over other apps first. Without it the panel cannot be shown.</string>
    <string name="fp_no_usage_warning">Without Usage access Game Master cannot tell when a game is open. The handle stays visible all the time and no sessions or per-game profiles run.</string>
    <string name="fp_active_game">Now: %1$s · %2$s</string>
    <string name="fp_permissions_title">What each permission is for</string>
    <string name="fp_why_overlay">Draws the handle and panel over your game.</string>
    <string name="fp_why_usage">Detects which app is in the foreground so a game session can start and end.</string>
    <string name="fp_why_notif">Shows the notification that keeps the assistant alive and lets you stop it.</string>
    <string name="fp_why_write">Lets a profile change brightness. Optional.</string>
    <string name="fp_why_dnd">Lets a profile switch on Do Not Disturb during a game. Optional.</string>
    <string name="fp_why_a11y">Only for the screenshot shortcut. Optional.</string>
    <string name="fp_restricted_hint">Android 13 and newer may grey out the screenshot service for apps installed outside a store. Open App info, tap the three dots and choose Allow restricted settings, then try again.</string>
    <string name="fp_boot_title">Start after reboot</string>
    <string name="fp_boot_desc">Starts the assistant again when the phone boots, if it was switched on.</string>
    <string name="fp_customize_title">Customize</string>
    <string name="fp_open_editor">Panel editor</string>
    <string name="fp_open_dock">Game dock</string>
    <string name="fp_limits_title">Good to know</string>
    <string name="fp_limits_body">Profiles change only what Android lets an app change: brightness, Do Not Disturb, media volume and keeping the screen awake. They never change CPU or GPU speed. FPS in the panel needs a one-time ADB permission. The latency number is a connection time, not your in-game ping. Screen recording has no sound.</string>
    <string name="pe_intro">Changes are saved at once. If the assistant is running, the panel updates right away.</string>
